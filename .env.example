# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# PostgreSQL Database (Supabase / Neon / AWS RDS)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Client
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Deployment Application URL
NEXT_PUBLIC_APP_URL=https://careertrack.app

# OpenAI & Embeddings (pgvector semantic search & embeddings)
OPENAI_API_KEY=

# Multi-Board Job Discovery APIs (Adzuna / RapidAPI)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# AI Provider API Key Encryption
AI_KEY_ENCRYPTION_SECRET=your-32-byte-secret-here-change-it

# Email Communication (Resend / Transactional Alerts)
RESEND_API_KEY=
EMAIL_FROM="CareerTrack Assistant <onboarding@resend.dev>"

# Durable Execution & Background Jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Upstash Serverless Redis (LTM Cache & Rate Limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Langfuse AI Observability & Monitoring (Traces, Latency & Token Costs)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Vercel Deployment
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
